{
  "backend": "git",
  "format": 1,
  "scenario": "edit",
  "steps": [
    {
      "arguments": {
        "content": "---\ntitle: Conformance edit\ndescription: Created for the edit scenario.\ntype: fact\n---\nOriginal.\n",
        "if_version": "new",
        "path": "me/fact/conformance-edit.md"
      },
      "identity": "primary",
      "is_error": false,
      "structured": {
        "commit": "<commit:1>",
        "id": "<ulid:1>",
        "path": "me/fact/conformance-edit.md",
        "version": "<version:1>"
      },
      "tool": "memory_write"
    },
    {
      "arguments": {
        "if_version": "<version:1>",
        "new_str": "Edited.\n",
        "old_str": "Original.\n",
        "path": "me/fact/conformance-edit.md"
      },
      "identity": "primary",
      "is_error": false,
      "structured": {
        "commit": "<commit:2>",
        "id": "<ulid:1>",
        "path": "me/fact/conformance-edit.md",
        "version": "<version:2>"
      },
      "tool": "memory_edit"
    }
  ]
}
