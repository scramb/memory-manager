# SPDX-License-Identifier: AGPL-3.0-only
#
# `docker compose up` / `podman compose up` (compose.yaml) works with no
# `.env` at all - every value the stack needs to boot is a plain literal in
# compose.yaml itself. Copy this file to `.env` only if you want to change
# one of the genuinely optional settings below (embeddings, CORS origins);
# `env_file: .../required: false` picks it up if present, and does nothing
# if it is not. Every value below is an example - replace it with your own
# before exposing this past localhost (CLAUDE.md: public repo, no
# operator-specific values committed here).
#
# VAULT_REMOTE, PUBLIC_URL and the Postgres credentials are deliberately
# NOT here: they are fixed, literal values in compose.yaml (a key set under
# a service's `environment:` always wins over the same key from `.env`, so
# listing them here would silently have no effect). Point the vault at a
# real Git remote, or change the public hostname, by editing compose.yaml
# directly - a real deployment is expected to adapt its own copy anyway
# (CLAUDE.md: deployment artefacts are generic).

# --- Public URL and MCP ------------------------------------------------------
# Comma-separated extra browser Origins allowed to call /mcp, beyond
# PUBLIC_URL's own origin (usually left empty - no browser-based client is
# expected to call this server directly).
#ALLOWED_ORIGINS=

# --- Storage backend ---------------------------------------------------------
# STORAGE_BACKEND=git (default, the only backend today - postgres is WP-18)
#STORAGE_BACKEND=git

# --- Embeddings (optional; full-text search works without one) -------------
# EMBEDDING_PROVIDER=none (default) | ollama | openai
#EMBEDDING_PROVIDER=none
# EMBEDDING_PROVIDER=ollama with the `ollama` compose profile enabled
# (`docker compose --profile ollama up`):
# EMBEDDING_PROVIDER=ollama
# EMBEDDING_URL=http://ollama:11434
# EMBEDDING_MODEL=bge-m3
# EMBEDDING_PROVIDER=openai (or any OpenAI-compatible embeddings endpoint):
# EMBEDDING_URL=https://api.openai.com/v1
# EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_API_KEY=change-me

# --- Admin login (not yet built) --------------------------------------------
# Available from the v0.1.0 admin-password login (#37); set once that
# ships to let a browser sign in without a pre-issued bearer token.
#ADMIN_PASSWORD_HASH=change-me
