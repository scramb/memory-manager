{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "pull-request-footer": "Before merging: fill this version's section in [docs/release/client-checklist.md](https://github.com/scramb/memory-manager/blob/main/docs/release/client-checklist.md) (copy `## Template` under `## Releases`).",
  "packages": {
    ".": {
      "release-type": "python",
      "package-name": "memory-manager",
      "include-component-in-tag": false,
      "bump-minor-pre-major": true,
      "bump-patch-for-minor-pre-major": true,
      "extra-files": [
        {
          "type": "generic",
          "path": "charts/memory-manager/Chart.yaml"
        },
        {
          "type": "generic",
          "path": "deploy/kustomization.yaml"
        },
        {
          "type": "toml",
          "path": "uv.lock",
          "jsonpath": "$.package[?(@.name.value=='memory-manager')].version"
        }
      ]
    }
  }
}
