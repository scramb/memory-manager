__pycache__/
*.pyc
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
dist/
*.egg-info/
.venv/
.claude/worktrees/

# OpenTofu/Terraform (deploy/entra, #256) - provider plugin cache and local
# state/plan artefacts, never committed. .terraform.lock.hcl is *not* ignored
# here: "tofu init" asks for it to be tracked so provider selection stays
# reproducible.
**/.terraform/
*.tfstate
*.tfstate.*
*.tfplan
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Open WebUI local stack (#141, WP-42) - scripts/openwebui-up.sh creates
# this with a random WEBUI_SECRET_KEY on first run; never committed (it is
# the per-deployment secret OAuth tokens get encrypted with, see
# deploy/openwebui/docker-compose.yml's header comment).
deploy/openwebui/.env

# Same stack's own AS secrets (#142): an argon2id admin password hash plus
# a Fernet client-secret encryption key, and the plaintext admin password
# the headless e2e driver logs in with - never committed, see
# deploy/openwebui/docker-compose.yml's header comment.
deploy/openwebui/.env-memory-manager
deploy/openwebui/.admin-password
