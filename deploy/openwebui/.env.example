# SPDX-License-Identifier: AGPL-3.0-only
#
# Copy to deploy/openwebui/.env - scripts/openwebui-up.sh does this
# automatically on first run, filling WEBUI_SECRET_KEY with a random value,
# and never overwrites an existing deploy/openwebui/.env afterwards.

# --- Required --------------------------------------------------------------
# Open WebUI encrypts stored OAuth client info and per-user session tokens
# with this key (docs/research/clients/openwebui.md "Other env"). It must
# stay the SAME value across restarts of this stack, or every previously
# stored OAuth session (relevant once #142/#143 wire up the connection to
# memory-manager) becomes undecryptable - never regenerate it for a stack
# you want to keep working. No example value is given on purpose (CLAUDE.md:
# public repository, no shared secrets committed) - leaving this unset
# makes Open WebUI generate and persist its own key, which also works, but
# then differs on every fresh `docker-compose.yml` volume.
WEBUI_SECRET_KEY=

# --- Optional ----------------------------------------------------------------
# Lets Open WebUI's own UI list models from the `ollama` service below.
# Only useful together with the `ollama` compose profile (it is not part
# of `make openwebui-up`'s own default run - see docker-compose.yml's
# header comment - so start that service explicitly first, for example
# `podman compose -f deploy/openwebui/docker-compose.yml -p mm-openwebui
# --profile ollama up -d ollama`); this variable on its own does not start it.
#ENABLE_OLLAMA_API=true
