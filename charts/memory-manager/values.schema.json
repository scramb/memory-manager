{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "memory-manager",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "storage": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "backend": {
          "type": "string",
          "enum": ["git", "postgres"],
          "description": "Source of truth for notes (ADR-0007). \"git\" (default) caps replicaCount at 1 and refuses an autoscaler; \"postgres\" (enterprise) lifts both (ADR-0009 §6)."
        }
      },
      "required": ["backend"]
    },
    "replicaCount": {
      "type": "integer",
      "minimum": 0,
      "description": "0 or 1 while storage.backend is \"git\" - memory-manager is then a single writer to the vault's git remote, never a scaled service. storage.backend \"postgres\" lifts the maximum."
    },
    "api": {
      "type": "object",
      "additionalProperties": true,
      "description": "storage.backend \"postgres\" only (ADR-0009 §4) - renders a separate api Deployment instead of the Deployment above.",
      "properties": {
        "replicaCount": { "type": "integer", "minimum": 0 },
        "resources": { "type": "object", "additionalProperties": true },
        "topologySpreadConstraints": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "enabled": { "type": "boolean" },
            "maxSkew": { "type": "integer", "minimum": 1 },
            "whenUnsatisfiable": { "type": "string", "enum": ["ScheduleAnyway", "DoNotSchedule"] }
          }
        },
        "autoscaling": {
          "type": "object",
          "additionalProperties": true,
          "description": "CPU HorizontalPodAutoscaler for the api Deployment (ADR-0009 addendum 2026-10-08) - mutually exclusive with api.keda.enabled.",
          "properties": {
            "enabled": { "type": "boolean" },
            "minReplicas": { "type": "integer", "minimum": 0 },
            "maxReplicas": { "type": "integer", "minimum": 0 },
            "targetCPUUtilizationPercentage": { "type": "integer", "minimum": 1, "maximum": 100 }
          }
        },
        "keda": {
          "type": "object",
          "additionalProperties": true,
          "description": "Optional KEDA ScaledObject for the api Deployment instead of the CPU HPA above (ADR-0009 addendum 2026-10-08) - mutually exclusive with api.autoscaling.enabled.",
          "properties": {
            "enabled": { "type": "boolean" },
            "minReplicaCount": { "type": "integer", "minimum": 0 },
            "maxReplicaCount": { "type": "integer", "minimum": 0 },
            "prometheus": {
              "type": "object",
              "additionalProperties": true,
              "properties": {
                "serverAddress": { "type": "string" },
                "query": { "type": "string" },
                "threshold": { "type": "string" }
              }
            }
          }
        }
      }
    },
    "worker": {
      "type": "object",
      "additionalProperties": true,
      "description": "storage.backend \"postgres\" only (ADR-0009 §4) - the embedding queue, Graph delta sync, retention and OAuth cleanup.",
      "properties": {
        "replicaCount": { "type": "integer", "minimum": 0 },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "resources": { "type": "object", "additionalProperties": true },
        "topologySpreadConstraints": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "enabled": { "type": "boolean" },
            "maxSkew": { "type": "integer", "minimum": 1 },
            "whenUnsatisfiable": { "type": "string", "enum": ["ScheduleAnyway", "DoNotSchedule"] }
          }
        },
        "autoscaling": {
          "type": "object",
          "additionalProperties": true,
          "description": "CPU HorizontalPodAutoscaler for the worker Deployment (ADR-0009 addendum 2026-10-08).",
          "properties": {
            "enabled": { "type": "boolean" },
            "minReplicas": { "type": "integer", "minimum": 0 },
            "maxReplicas": { "type": "integer", "minimum": 0 },
            "targetCPUUtilizationPercentage": { "type": "integer", "minimum": 1, "maximum": 100 }
          }
        }
      }
    },
    "shutdown": {
      "type": "object",
      "additionalProperties": true,
      "description": "Graceful shutdown (ADR-0009 §5), storage.backend \"postgres\" only - terminationGracePeriodSeconds must be at least graceSeconds + preStopSleepSeconds (enforced by the chart's own validateShutdown helper).",
      "properties": {
        "graceSeconds": { "type": "integer", "minimum": 0 },
        "preStopSleepSeconds": { "type": "integer", "minimum": 0 },
        "terminationGracePeriodSeconds": { "type": "integer", "minimum": 0 }
      }
    },
    "pdb": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "api": {
          "type": "object",
          "additionalProperties": true,
          "properties": { "minAvailable": { "type": "integer", "minimum": 0 } }
        }
      }
    },
    "image": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "pullPolicy": { "type": "string", "enum": ["Always", "IfNotPresent", "Never"] },
        "tag": { "type": "string" }
      },
      "required": ["repository"]
    },
    "imagePullSecrets": { "type": "array" },
    "nameOverride": { "type": "string" },
    "fullnameOverride": { "type": "string" },
    "serviceAccount": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "create": { "type": "boolean" },
        "annotations": { "type": "object" },
        "name": { "type": "string" }
      }
    },
    "podAnnotations": { "type": "object" },
    "podSecurityContext": { "type": "object", "additionalProperties": true },
    "securityContext": { "type": "object", "additionalProperties": true },
    "service": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "type": { "type": "string" },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 }
      }
    },
    "resources": { "type": "object", "additionalProperties": true },
    "probes": { "type": "object", "additionalProperties": true },
    "nodeSelector": { "type": "object" },
    "tolerations": { "type": "array" },
    "affinity": { "type": "object" },
    "publicUrl": { "type": "string", "minLength": 1 },
    "vault": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "remote": { "type": "string", "minLength": 1 },
        "branch": { "type": "string", "minLength": 1 }
      },
      "required": ["remote"]
    },
    "login": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "mode": { "type": "string", "enum": ["oidc", "entra", "password"] },
        "oidc": { "type": "object", "additionalProperties": true },
        "entra": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "tenantId": { "type": "string" },
            "clientId": { "type": "string" },
            "allowedTenants": { "type": "string" },
            "authority": { "type": "string" },
            "graphUrl": { "type": "string" },
            "allowInsecureAuthority": { "type": "boolean" },
            "groupsTtlSeconds": { "type": ["number", "null"], "minimum": 1 },
            "accessTokenMinutes": { "type": ["number", "null"], "minimum": 1 },
            "maxSessionSeconds": { "type": ["number", "null"], "minimum": 1 }
          }
        },
        "namespaces": { "type": "string" }
      }
    },
    "embedding": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "provider": { "type": "string", "enum": ["none", "ollama", "openai"] },
        "url": { "type": "string" },
        "model": { "type": "string" },
        "dimensions": { "type": ["integer", "null"], "minimum": 1 },
        "apiKeySecretKey": { "type": "string" }
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": true,
      "properties": { "enabled": { "type": "boolean" } }
    },
    "logFormat": { "type": "string" },
    "secrets": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "existingSecret": { "type": "string" },
        "create": { "type": "boolean" },
        "values": { "type": "object" }
      }
    },
    "database": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "cnpg": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "enabled": { "type": "boolean" },
            "instances": {
              "type": "integer",
              "minimum": 1,
              "description": "More than 1 requires storage.backend \"postgres\" (ADR-0007, ADR-0009 §6)."
            },
            "imageName": { "type": "string", "minLength": 1 },
            "storage": { "type": "object", "additionalProperties": true },
            "resources": { "type": "object", "additionalProperties": true },
            "backup": {
              "type": "object",
              "additionalProperties": true,
              "description": "Barman Cloud plugin backups for the CNPG Cluster (#252) - renders an ObjectStore, a WAL-archiving plugin entry on the Cluster and a ScheduledBackup.",
              "properties": {
                "enabled": { "type": "boolean" },
                "schedule": { "type": "string", "minLength": 1 },
                "retentionPolicy": { "type": "string", "pattern": "^[1-9][0-9]*[dwm]$" },
                "destinationPath": { "type": "string", "minLength": 1 },
                "endpointURL": { "type": "string" },
                "existingSecret": { "type": "string" },
                "accessKeyIdKey": { "type": "string", "minLength": 1 },
                "secretAccessKeyKey": { "type": "string", "minLength": 1 },
                "compression": {
                  "type": "string",
                  "enum": ["", "bzip2", "gzip", "lz4", "snappy", "xz", "zstd"]
                }
              }
            }
          }
        },
        "url": { "type": "string" },
        "existingSecret": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "name": { "type": "string" },
            "key": { "type": "string" }
          }
        },
        "appRole": {
          "type": "string",
          "description": "api only (storage.backend \"postgres\") - DATABASE_APP_ROLE, the non-owner role request transactions switch to (ADR-0008 addendum)."
        }
      }
    },
    "valkey": {
      "type": "object",
      "additionalProperties": true,
      "description": "Optional single-primary Valkey for shared rate-limit/login state (ADR-0009 §2, #254) - mutually exclusive with externalUrl below, checked by the chart's own validateValkey template helper (values.schema.json cannot express mutual exclusion between two independently optional fields as an \"if\"/\"then\").",
      "properties": {
        "enabled": { "type": "boolean" },
        "image": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "repository": { "type": "string", "minLength": 1 },
            "tag": { "type": "string", "minLength": 1 },
            "pullPolicy": { "type": "string" }
          }
        },
        "resources": { "type": "object", "additionalProperties": true },
        "existingSecret": { "type": "string" },
        "passwordKey": { "type": "string" },
        "externalUrl": { "type": "string" }
      }
    },
    "httpRoute": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "enabled": { "type": "boolean" },
        "parentRefs": { "type": "array" },
        "hostnames": { "type": "array", "items": { "type": "string" } }
      }
    },
    "ingress": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "enabled": { "type": "boolean" },
        "className": { "type": "string" },
        "annotations": { "type": "object" },
        "hosts": { "type": "array" },
        "tls": { "type": "array" }
      }
    },
    "networkPolicy": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "enabled": { "type": "boolean" },
        "ingress": { "type": "object", "additionalProperties": true },
        "egress": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "allowAll": { "type": "boolean" },
            "rules": { "type": "array" }
          }
        },
        "prometheus": { "type": "object", "additionalProperties": true },
        "cnpgOperator": { "type": "object", "additionalProperties": true }
      }
    },
    "serviceMonitor": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "enabled": { "type": "boolean" },
        "interval": { "type": "string" },
        "labels": { "type": "object" }
      }
    },
    "grafanaDashboard": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "enabled": { "type": "boolean" },
        "sidecarLabel": { "type": "string" },
        "sidecarLabelValue": { "type": "string" }
      }
    },
    "prometheusRule": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "enabled": { "type": "boolean" },
        "labels": { "type": "object" },
        "thresholds": { "type": "object", "additionalProperties": true }
      }
    }
  },
  "required": ["image", "service", "publicUrl", "vault", "storage"],
  "if": {
    "properties": {
      "storage": {
        "properties": { "backend": { "const": "git" } }
      }
    }
  },
  "then": {
    "properties": {
      "replicaCount": {
        "maximum": 1,
        "description": "storage.backend \"git\" allows at most 1 replica (ADR-0007, ADR-0009 §6)."
      },
      "database": {
        "properties": {
          "cnpg": {
            "properties": {
              "instances": {
                "maximum": 1,
                "description": "storage.backend \"git\" allows at most 1 CNPG instance (ADR-0007, ADR-0009 §6)."
              }
            }
          }
        }
      },
      "login": {
        "properties": {
          "mode": {
            "enum": ["oidc", "password"],
            "description": "storage.backend \"git\" never allows login.mode \"entra\" (ADR-0006 addendum 2026-10-08: the server's own build_authenticator, http.py, refuses to start LOGIN_MODE=entra without STORAGE_BACKEND=postgres, #257)."
          }
        }
      }
    }
  }
}
