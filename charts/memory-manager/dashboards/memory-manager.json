{
  "title": "memory-manager",
  "uid": "memory-manager",
  "schemaVersion": 39,
  "version": 1,
  "tags": ["memory-manager"],
  "timezone": "utc",
  "editable": true,
  "graphTooltip": 1,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "30s",
  "panels": [
    {
      "id": 1,
      "title": "Tool call rate",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        {
          "expr": "sum(rate(mm_tool_calls_total[5m])) by (tool)",
          "legendFormat": "{{tool}}"
        }
      ]
    },
    {
      "id": 2,
      "title": "Tool error rate",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        {
          "expr": "sum(rate(mm_tool_calls_total{outcome=\"error\"}[5m])) by (tool)",
          "legendFormat": "{{tool}}"
        }
      ]
    },
    {
      "id": 3,
      "title": "Tool call duration p95",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 8, "w": 12, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(mm_tool_duration_seconds_bucket[5m])) by (le, tool))",
          "legendFormat": "{{tool}}"
        }
      ]
    },
    {
      "id": 4,
      "title": "Search duration p95 by mode",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 8, "w": 12, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(mm_search_duration_seconds_bucket[5m])) by (le, mode))",
          "legendFormat": "{{mode}}"
        }
      ]
    },
    {
      "id": 5,
      "title": "Rate-limit hits by limiter",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 16, "w": 12, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        {
          "expr": "sum(rate(mm_rate_limit_hits_total[5m])) by (limiter)",
          "legendFormat": "{{limiter}}"
        }
      ]
    },
    {
      "id": 6,
      "title": "Jobs pending by kind",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 16, "w": 12, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        {
          "expr": "mm_jobs_pending",
          "legendFormat": "{{kind}}"
        }
      ]
    },
    {
      "id": 7,
      "title": "Jobs oldest pending age by kind",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 24, "w": 12, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "expr": "mm_jobs_oldest_pending_age_seconds",
          "legendFormat": "{{kind}}"
        }
      ]
    },
    {
      "id": 8,
      "title": "Embedding lag",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 24, "w": 12, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "expr": "mm_embedding_lag_seconds",
          "legendFormat": "embedding lag"
        }
      ]
    },
    {
      "id": 9,
      "title": "Ready api replicas",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 32, "w": 12, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        {
          "expr": "kube_deployment_status_replicas_ready{deployment=~\".*-api\"}",
          "legendFormat": "{{deployment}}"
        }
      ]
    },
    {
      "id": 10,
      "title": "Build info",
      "type": "stat",
      "gridPos": { "x": 12, "y": 32, "w": 12, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        {
          "expr": "mm_build_info",
          "legendFormat": "{{version}} ({{commit}})"
        }
      ]
    }
  ]
}
